{
  // ============================================================
  //  MISSINGNESS CONVENTION  — read first. Applies to EVERY field below.
  //  A field is never guessed. If it isn't in the text, mark it explicitly:
  //    "not_stated"      = the article doesn't say (real missing data)
  //    "not_applicable"  = the field makes no sense for this event type
  //                        (e.g. a price spike has no subpopulation)
  //  These are DIFFERENT and must not collapse into one null.
  //  The model NEVER imputes a plausible value. Unknowable -> "not_stated".
  //  Downstream: "not_stated" severity is NOT zero — fall back to a
  //  count-with-confidence, never multiply the event away.
  // ============================================================

  // ============================================================
  //  ARTICLE-LEVEL  — context about the source document.
  //  From metadata or source priors, NOT extracted from the text.
  // ============================================================
  "article": {
    "article_id":         "string",   // unique ID of the article
    "pub_date":           "ISO-8601", // when PUBLISHED (= when info became knowable). From metadata. Never extracted.
    "source":             "string",   // outlet name, e.g. "Reuters"
    "source_type":        "enum",     // wire | national | local | NGO/UN | govt
    "source_reliability": "0-3",      // source trust level (0 = low, 3 = high). From source priors, not the text.
    "no_relevant_event":  "bool"      // true if nothing relevant. Distinguishes "empty" from "extraction failed".
  },

  // ============================================================
  //  EVENTS  — a LIST. One record per distinct event.
  //  Three hazards mentioned => three records. Do not merge.
  // ============================================================
  "events": [
    {
      "event_id":         "string",   // local ID (e.g. "e1"); edges point at this

      "record_type":      "enum",     // hazard = a threat | response = aid / intervention / coping action
      "type":             "string",   // specific label from your taxonomy (e.g. "armed_conflict", "food_price_spike")

      // --- WHERE ---
      "country":          "string",   // country name
      "admin1":           "string",   // region / province ("not_stated" if absent)
      "admin2":           "string",   // district ("not_stated" if absent) — the prediction-target level.
                                       // NOTE: admin2 missingness correlates with source_type. Track it, don't drop on it.
      "spatial_scope":    "enum",     // point | localized | spreading | regional. PROBATIONARY: check reliability before use.

      // --- WHAT DIRECTION ---
      "direction":        "enum",     // onset | escalating | stable | easing | resolved — trend of the event itself
      "fs_sign":          "enum",     // worsening | improving | ambiguous — effect on food security.
                                       // Near-duplicate of direction for hazards; only separates for responses (aid = improving).
      "ipc_dimension":    "enum",     // availability | access | utilization | stability — which pillar it hits

      // --- WHO / WHAT IS AFFECTED ---
      "affected_entity":  "string",   // what is hit, e.g. "maize crop", "local market", "pastoral livelihoods"
      "subpopulation":    "string",   // affected group, e.g. "pastoralists", "IDPs". PROBATIONARY. "not_stated"/"not_applicable".

      // --- HOW BAD (raw figure only; bucket downstream, not here) ---
      "severity_value":   "number",   // raw figure if stated, e.g. 5000. "not_stated" if none. NOT zero when missing.
      "severity_unit":    "string",   // what it counts, e.g. "households displaced". "not_stated" if none.

      // --- WHEN (two separate clocks — this drives lead time) ---
      "time_status":      "enum",     // past | ongoing | forecast — owns "has it happened yet". (See evidentiality note.)
      "event_time":       "string",   // WHEN THE EVENT OCCURS (date or relative e.g. "+5mo"). Differs from pub_date. "not_stated" if unclear.

      // --- HOW SURE ---
      "evidentiality":    "enum",     // confirmed | reported | rumored — firmness of the claim.
                                       // ("projected" removed: time_status=forecast already owns "not yet happened".)
      "attribution":      "string",   // who asserts it, e.g. "UN FAO", "local official", "eyewitness"
      "confidence":       "0-1",      // model confidence in this record

      // --- PROOF (one quote per event) ---
      "grounding_quote":  "span"      // exact text this event rests on. REQUIRED.
                                       // If any field above can't be grounded in the article, set THAT field to "not_stated".
    }
  ],

  // ============================================================
  //  EDGES  — a LIST of cause -> effect links between events above.
  //  Builds the knowledge graph. Reference events by event_id.
  // ============================================================
  "edges": [
    {
      "cause_event_id":  "string",    // event_id of the cause
      "effect_event_id": "string",    // event_id of the effect
      "modality":        "enum",      // asserted = article states it | hypothesized = suggested | denied = ruled out
      "grounding_quote": "span"       // exact text the causal link rests on
    }
  ]
}
