# Copy to .env and fill in your values.
# Source before running submit_batch.sh:  set -a && source .env && set +a

# ---------------------------------------------------------------------------
# GCP infrastructure
# ---------------------------------------------------------------------------

# GCP project ID
GCP_PROJECT=my-gcp-project

# Region for Cloud Batch jobs and Artifact Registry
# L4 availability: us-central1, us-east1, europe-west4
# A100 availability: us-central1, us-east1, asia-northeast1
GCP_REGION=us-central1

# Artifact Registry — Docker image for the relevance container
# Format: REGION-docker.pkg.dev/PROJECT/REPO/IMAGE:TAG
IMAGE=us-central1-docker.pkg.dev/my-gcp-project/event-extraction/relevance-infer:latest

# ---------------------------------------------------------------------------
# GCS paths
# ---------------------------------------------------------------------------

# Directory holding the pre-sharded manifests (manifest-000.jsonl ...) from build_manifest.py
MANIFEST_GCS_PREFIX=gs://my-bucket/relevance/manifests

# Output prefix — shard files written as $OUTPUT_GCS_PREFIX/shard-N.csv  (id,label; no merge)
OUTPUT_GCS_PREFIX=gs://my-bucket/relevance/output/run-001

# Trained relevance classifier directory (config.json + tokenizer + weights)
# Upload once: gsutil -m cp -r outputs/relevance/.../checkpoint-XXXX/ $MODEL_GCS/
MODEL_GCS=gs://my-bucket/models/relevance-modernbert

# ---------------------------------------------------------------------------
# Job configuration (submit_batch.sh)
# ---------------------------------------------------------------------------

# GPU tier: spot-l4 | spot-a100 | flex-l4 | flex-a100 | l4 | a100
TIER=spot-l4

# Number of parallel GPU tasks (MUST equal the number of manifest-*.jsonl files).
# At ~120 articles/s on L4, total GPU-time is fixed at ~324 GPU-h for 140M articles;
# wall-clock = 324 h / SHARDS:  100 shards ≈ ~3.2 h, 140 shards ≈ ~2.3 h.
SHARDS=100

# Optional: override the auto-generated job ID (relevance-YYYYMMDD-HHMMSS)
# JOB_ID=relevance-run-001

# ---------------------------------------------------------------------------
# Inference parameters (passed to each task container)
# ---------------------------------------------------------------------------

# Max article characters used to build the classifier input (title + body[:MAX_CHARS])
MAX_CHARS=4000

# Tokenizer / vLLM max sequence length
MAX_LENGTH=2048

# Texts per vLLM classify() call
BATCH_SIZE=2000

# Concurrent GCS GETs per worker (only needs to sustain ~120 art/s)
GCS_READ_CONCURRENCY=64

# Fraction of GPU VRAM vLLM may use
GPU_MEMORY_UTIL=0.9

# ---------------------------------------------------------------------------
# Injected automatically by Cloud Batch — DO NOT set these manually
# ---------------------------------------------------------------------------
# BATCH_TASK_INDEX   0-based index of the current task (selects manifest-NNN.jsonl)
# BATCH_TASK_COUNT   total number of tasks (= SHARDS)
