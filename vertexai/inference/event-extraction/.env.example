# Copy to .env and fill in your values.
# Source before running submit_batch.sh:  set -a && source .env && set +a

# ---------------------------------------------------------------------------
# GCP infrastructure
# ---------------------------------------------------------------------------

# GCP project ID
GCP_PROJECT=my-gcp-project

# Region for Cloud Batch jobs and Artifact Registry
# L4 availability: us-central1, us-east1, europe-west4
# A100 availability: us-central1, us-east1, asia-northeast1
GCP_REGION=us-central1

# Artifact Registry — Docker image for the inference container
# Format: REGION-docker.pkg.dev/PROJECT/REPO/IMAGE:TAG
IMAGE=us-central1-docker.pkg.dev/my-gcp-project/my-repo/event-infer:latest

# ---------------------------------------------------------------------------
# GCS paths
# ---------------------------------------------------------------------------

# GCS bucket (no trailing slash)
GCS_BUCKET=gs://my-bucket

# Manifest prefix — holds manifest-000.jsonl ... manifest-NNN.jsonl, one per shard.
# Build it first (metadata only, no article bodies):
#   python build_manifest.py --output-prefix $MANIFEST_GCS_PREFIX --num-shards $SHARDS
MANIFEST_GCS_PREFIX=gs://my-bucket/extraction/manifests

# Output prefix — shard files will be written as $OUTPUT_GCS_PREFIX/shard-N.jsonl
OUTPUT_GCS_PREFIX=gs://my-bucket/extraction/output/run-001

# Merged model weights directory (qwen3-4b-merged or similar)
# Upload once: gsutil -m cp -r models/new_schema/.../merged/ $MODEL_GCS/
MODEL_GCS=gs://my-bucket/models/qwen3-4b-merged

# ---------------------------------------------------------------------------
# Job configuration (submit_batch.sh)
# ---------------------------------------------------------------------------

# GPU tier: spot-l4 | spot-a100 | flex-l4 | flex-a100 | l4 | a100
TIER=spot-a100

# Number of parallel GPU tasks. MUST equal the number of manifest-NNN.jsonl files —
# task N reads manifest-NNN.jsonl. submit_batch.sh refuses to submit on a mismatch.
# Cost is flat in shard count (you pay total GPU-hours); shards only buy wall clock.
#   33M articles on A100 @ 0.25 s/article ≈ 2,292 GPU-h → 100 shards ≈ 23 h, 200 ≈ 11.5 h
#   33M articles on L4   @ 1.3  s/article ≈ 11,917 GPU-h → 200 shards ≈ 60 h, 400 ≈ 30 h
SHARDS=200

# Optional: override the auto-generated job ID (infer-YYYYMMDD-HHMMSS)
# JOB_ID=infer-run-001

# ---------------------------------------------------------------------------
# Inference parameters (passed to each task container)
# ---------------------------------------------------------------------------

# Max tokens the model may generate per window
MAX_NEW_TOKENS=4096

# Max context length vLLM allocates (leave unset to let vLLM auto-detect)
# Set explicitly if you hit OOM: 8192 is safe for L4 with this model
# MAX_MODEL_LEN=8192

# Article windowing
MAX_CHARS=3000
MIN_CHARS=200
MAX_PARAS=15
OVERLAP_PARAS=1

# vLLM continuous-batching queue size per task
BATCH_SIZE=500

# Fraction of GPU VRAM vLLM may use
GPU_MEMORY_UTIL=0.95

# Sampling temperature (0.0 = greedy)
TEMPERATURE=0.0

# Constrain event_type to the ontology enum via vLLM guided decoding. Off by default:
# it costs throughput, but without it the model occasionally invents labels outside
# bona.v4 (measured 0.012% of events), and scripts/geocoding/to_csv_ingest.py exits(1)
# on the first unknown event_type.
USE_GUIDED_DECODING=false
# GUIDED_DECODING_BACKEND=xgrammar

# Ontology selection. Defaults to ontologies/zhai/bona.v4.json (48 labels).
# ONTOLOGY_DESCRIPTIONS must be 'all' for the *-desc model variants.
# ONTOLOGY=ontologies/zhai/bona.v4.json
# ONTOLOGY_DESCRIPTIONS=none

# Concurrent GCS GETs per task for streaming article bodies out of the manifest's
# gcs_path values. 64 keeps the fetch pool well ahead of the GPU.
GCS_READ_CONCURRENCY=64

# true  → each output line is {"id", "predictions"} (~1 KB/article, all that
#         scripts/geocoding/{add_geotaxonomy,to_csv_ingest}.py read)
# false → full echo of the input row + per-window raw output (~20 KB/article)
LEAN_OUTPUT=true

# Limit candidate event types from ontology (leave unset to use all).
# Only has an effect when a row carries a `candidates` field (i.e. with the retriever);
# with the plain 48-label bona.v4 ontology every row gets the full list regardless.
# TOP_K_CANDIDATES=70

# ---------------------------------------------------------------------------
# Injected automatically by Cloud Batch — DO NOT set these manually
# ---------------------------------------------------------------------------
# BATCH_TASK_INDEX   0-based index of the current task
# BATCH_TASK_COUNT   total number of tasks (= SHARDS)
