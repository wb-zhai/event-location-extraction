# Copy to .env and fill in your values.
# Source before running submit_batch.sh:  set -a && source .env && set +a

# ---------------------------------------------------------------------------
# GCP infrastructure
# ---------------------------------------------------------------------------

# GCP project ID
GCP_PROJECT=my-gcp-project

# Region for Cloud Batch jobs and Artifact Registry
# L4 availability: us-central1, us-east1, europe-west4
# A100 availability: us-central1, us-east1, asia-northeast1
GCP_REGION=us-central1

# Artifact Registry — Docker image for the inference container
# Format: REGION-docker.pkg.dev/PROJECT/REPO/IMAGE:TAG
IMAGE=us-central1-docker.pkg.dev/my-gcp-project/my-repo/event-infer:latest

# ---------------------------------------------------------------------------
# GCS paths
# ---------------------------------------------------------------------------

# GCS bucket (no trailing slash)
GCS_BUCKET=gs://my-bucket

# Input JSONL file (one article per line)
INPUT_GCS=gs://my-bucket/data/input.jsonl

# Output prefix — shard files will be written as $OUTPUT_GCS_PREFIX/shard-N.jsonl
OUTPUT_GCS_PREFIX=gs://my-bucket/output/run-001

# Merged model weights directory (qwen3-4b-merged or similar)
# Upload once: gsutil -m cp -r models/new_schema/.../merged/ $MODEL_GCS/
MODEL_GCS=gs://my-bucket/models/qwen3-4b-merged

# ---------------------------------------------------------------------------
# Job configuration (submit_batch.sh)
# ---------------------------------------------------------------------------

# GPU tier: spot-l4 | l4 | a100
TIER=spot-l4

# Number of parallel GPU tasks (= number of shards)
# Rule of thumb at 1.3 s/article on L4:
#   300K articles → 20 shards ≈ 5.4 h
#   1M   articles → 45 shards ≈ 8 h  |  90 shards ≈ 4 h
SHARDS=20

# Optional: override the auto-generated job ID (infer-YYYYMMDD-HHMMSS)
# JOB_ID=infer-run-001

# ---------------------------------------------------------------------------
# Inference parameters (passed to each task container)
# ---------------------------------------------------------------------------

# Max tokens the model may generate per window
MAX_NEW_TOKENS=4096

# Max context length vLLM allocates (leave unset to let vLLM auto-detect)
# Set explicitly if you hit OOM: 8192 is safe for L4 with this model
# MAX_MODEL_LEN=8192

# Article windowing
MAX_CHARS=3000
MIN_CHARS=200
MAX_PARAS=15
OVERLAP_PARAS=1

# vLLM continuous-batching queue size per task
BATCH_SIZE=500

# Fraction of GPU VRAM vLLM may use
GPU_MEMORY_UTIL=0.95

# Sampling temperature (0.0 = greedy)
TEMPERATURE=0.0

# Limit candidate event types from ontology (leave unset to use all)
# TOP_K_CANDIDATES=10

# ---------------------------------------------------------------------------
# Injected automatically by Cloud Batch — DO NOT set these manually
# ---------------------------------------------------------------------------
# BATCH_TASK_INDEX   0-based index of the current task
# BATCH_TASK_COUNT   total number of tasks (= SHARDS)
