# Copy to .env and fill in your values.
# Source before running build_push.sh / submit_job.sh:  set -a && source .env && set +a

# ---------------------------------------------------------------------------
# GCP infrastructure
# ---------------------------------------------------------------------------

# GCP project ID
GCP_PROJECT=your-gcp-project-id

# Region for Vertex AI custom jobs and Artifact Registry
GCP_REGION=us-central1

# Artifact Registry — Docker image for the training container
# Format: REGION-docker.pkg.dev/PROJECT/llamafactory/trainer:TAG
# Printed by build_push.sh after a successful build.
IMAGE=us-central1-docker.pkg.dev/your-gcp-project-id/llamafactory/trainer:latest

# ---------------------------------------------------------------------------
# GCS paths
# ---------------------------------------------------------------------------

# GCS bucket (no trailing slash)
GCS_BUCKET=your-gcs-bucket

# Dataset directory inside the bucket (must contain dataset_info.json + data files)
GCS_DATA_PREFIX=data

# Checkpoint output root inside the bucket
GCS_SAVE_PREFIX=experiments

# Path to the training YAML inside the bucket
GCS_TRAIN_CONFIG=vertexai/configs/train_config.yaml

# ---------------------------------------------------------------------------
# Job configuration (submit_job.sh)
# ---------------------------------------------------------------------------

# W&B API key (required — training reports to wandb)
WANDB_API_KEY=your-wandb-api-key

# Hugging Face token — leave empty if the base model is public
HF_TOKEN=

# Prefix for the auto-generated job name (<prefix>-<gpu>-<timestamp>)
JOB_NAME_PREFIX=qwen3_5-4b-base-lora
